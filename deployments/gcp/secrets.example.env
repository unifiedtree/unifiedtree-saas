# =============================================================================
# UnifiedTree HRMS — Secret Manager input template.
#
# Copy to secrets.env (git-ignored), fill REAL values, then:
#   set -a; source secrets.env; set +a
#   ./provision.sh secrets
#
# NEVER commit real values. secrets.env is covered by .gitignore (.env*).
# Rotate every secret that was ever pasted into Railway/WhatsApp/chat BEFORE
# go-live — treat all previously-shared values as compromised.
# =============================================================================

# --- Database ---------------------------------------------------------------
# Password for the Cloud SQL 'ut_app' role the backend logs in as.
# Generate: openssl rand -base64 24
DB_APP_PASSWORD=

# --- Auth -------------------------------------------------------------------
# JWT signing secret. MUST be >= 32 chars; canonical-prod refuses to start
# with the placeholder. Generate: openssl rand -base64 48
UNIFIEDTREE_JWT_SECRET=

# --- Face verification ------------------------------------------------------
# 32-byte AES-GCM key, base64. App refuses to start if missing.
# Generate: openssl rand -base64 32
UNIFIEDTREE_FACE_ENCRYPTION_KEY=

# --- Email ------------------------------------------------------------------
# Gmail app password (SMTP fallback) and Brevo REST API key (primary sender).
SMTP_PASS=
BREVO_API_KEY=
